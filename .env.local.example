NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
# Required to create/remove staff logins from Equipas e tarefas.
# Find it in Supabase Dashboard > Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pagamentos online (Stripe) — OPCIONAL.
# A forma normal de configurar isto é pela app, em Integrações: as chaves
# ficam cifradas no Vault do Supabase. Estas variáveis existem só como
# alternativa, para quem prefira configurar por deploy.
STRIPE_SECRET_KEY=
# Segredo do endpoint do webhook (stripe listen, ou o dashboard em produção)
STRIPE_WEBHOOK_SECRET=
# URL base usada nos returns do Checkout (em produção, o domínio real)
NEXT_PUBLIC_APP_URL=http://localhost:3000
